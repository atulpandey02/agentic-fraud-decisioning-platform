# =============================================================
# .env.example — copy to .env and fill in real values.
# .env is git-ignored; never commit real credentials.
# Defaults shown match the Docker Compose stack and code defaults,
# so for local dev you often only need the Snowflake + Groq secrets.
# =============================================================

# ---- Snowflake ----
SNOWFLAKE_ACCOUNT=your-account-locator        # e.g. AB12345 (the account identifier)
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=changeme
SNOWFLAKE_DATABASE=FRAUD_DETECTION
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=ACCOUNTADMIN                    # used for schema/rbac/migrations bootstrap
SNOWFLAKE_SCHEMA=DIM

# Optional least-privilege role overrides (default to the roles rbac.sql creates):
# BI_SNOWFLAKE_ROLE=BI_ROLE
# AGENT_SNOWFLAKE_ROLE=AGENT_ROLE
# PIPELINE_SNOWFLAKE_ROLE=PIPELINE_ROLE
# MIGRATION_SNOWFLAKE_ROLE=ACCOUNTADMIN

# ---- LLM (Groq) ----
GROQ_API_KEY=your-groq-api-key
# AGENT_LLM_MODEL=llama-3.3-70b-versatile

# ---- Observability (LangSmith — optional, graceful no-op without a key) ----
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=fraud-decisioning-platform

# ---- Redis (online feature store) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---- Weaviate (policy RAG) ----
WEAVIATE_HOST=localhost
WEAVIATE_HTTP_PORT=8090
WEAVIATE_GRPC_PORT=50051

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---- Feature write path ----
# "snowpipe" (default): buffer Parquet to S3, Snowpipe auto-ingests.
# "direct": write features straight to Snowflake (no Snowpipe needed).
# FEATURE_WRITE_MODE=snowpipe

# ---- AWS / S3 (only needed for the Snowpipe write path) ----
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# AWS_REGION=us-east-1
